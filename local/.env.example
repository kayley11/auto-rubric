# Copy this template to .env in the project root. Shell environment variables take precedence.
# This deployment uses the KCL OpenAI-compatible API.
# Models: openai/arc:apex, openai/arc:nexus, openai/arc:lite, openai/arc:nano.
AUTORUBRIC_MODEL=openai/arc:nexus
OPENAI_API_KEY=
OPENAI_BASE_URL=https://ai.create.kcl.ac.uk/api/v1
# Do not include /chat/completions in the base URL.

AUTORUBRIC_MAX_TOKENS=1024
AUTORUBRIC_TIMEOUT=180
AUTORUBRIC_CONCURRENCY=1

# Use the model pricing table bundled with the locked LiteLLM version.
LITELLM_LOCAL_MODEL_COST_MAP=True
